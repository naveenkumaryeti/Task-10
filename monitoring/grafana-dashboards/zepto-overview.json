{
  "title": "Zepto Platform Overview",
  "panels": [
    { "title": "CPU Usage per Pod", "type": "timeseries", "targets": [{ "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"zepto\"}[5m])) by (pod)" }] },
    { "title": "Memory Usage per Pod", "type": "timeseries", "targets": [{ "expr": "sum(container_memory_working_set_bytes{namespace=\"zepto\"}) by (pod)" }] },
    { "title": "Pod Restart Count", "type": "timeseries", "targets": [{ "expr": "kube_pod_container_status_restarts_total{namespace=\"zepto\"}" }] },
    { "title": "HTTP Request Rate", "type": "timeseries", "targets": [{ "expr": "sum(rate(http_requests_total{namespace=\"zepto\"}[5m])) by (service)" }] },
    { "title": "HTTP Error Rate (5xx)", "type": "timeseries", "targets": [{ "expr": "sum(rate(http_requests_total{namespace=\"zepto\",status=~\"5..\"}[5m]))" }] }
  ]
}
